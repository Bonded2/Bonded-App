service : {
  health_check : () -> (text);
  greet : (text) -> (text);
  whoami : () -> (principal);
  register_user : (opt text) -> (variant { Ok : text; Err : text; });
  upload_evidence : (text, vec nat8, record { timestamp : nat64; content_type : text; location : opt text; description : opt text; tags : vec text; }, text, opt vec nat8) -> (variant { Ok : text; Err : text; });
  get_timeline : (text, opt nat32, opt text, opt nat64, opt nat64) -> (variant { Ok : record { evidence : vec record { id : text; relationship_id : text; encrypted_data : vec nat8; metadata : record { timestamp : nat64; content_type : text; location : opt text; description : opt text; tags : vec text; }; upload_timestamp : nat64; hash : text; uploader : principal; signature : opt vec nat8; }; total_count : nat64; has_more : bool; }; Err : text; });
  create_partner_invite : (record { partner_email : text; inviter_name : text; expires_at : nat64; metadata : opt text; frontend_url : opt text; }) -> (variant { Ok : record { invite_id : text; invite_link : text; expires_at : nat64; }; Err : text; });
  get_partner_invite : (text) -> (variant { Ok : record { id : text; inviter_principal : principal; partner_email : text; inviter_name : text; status : variant { Pending; Accepted; Expired; Cancelled; }; created_at : nat64; expires_at : nat64; metadata : opt text; }; Err : text; });
  accept_partner_invite : (text) -> (variant { Ok : record { relationship_id : text; relationship : record { id : text; partner1 : principal; partner2 : opt principal; status : variant { Pending; Active; Terminated; }; created_at : nat64; bonded_key_share : vec nat8; evidence_count : nat64; last_activity : nat64; }; user_key_share : vec nat8; public_key : vec nat8; }; Err : text; });
  create_relationship : (record { partner_principal : principal; }) -> (variant { Ok : record { relationship_id : text; user_key_share : vec nat8; public_key : vec nat8; }; Err : text; });
  get_relationship : (text) -> (variant { Ok : record { id : text; partner1 : principal; partner2 : opt principal; status : variant { Pending; Active; Terminated; }; created_at : nat64; bonded_key_share : vec nat8; evidence_count : nat64; last_activity : nat64; }; Err : text; });
  get_user_relationships : () -> (variant { Ok : vec record { id : text; partner1 : principal; partner2 : opt principal; status : variant { Pending; Active; Terminated; }; created_at : nat64; bonded_key_share : vec nat8; evidence_count : nat64; last_activity : nat64; }; Err : text; });
}