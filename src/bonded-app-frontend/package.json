{
  "name": "bonded-app-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "build": "vite build",
    "build:laptop": "NODE_OPTIONS=\"--max-old-space-size=1024\" VITE_BUILD_MODE=laptop vite build",
    "build:fast": "NODE_OPTIONS=\"--max-old-space-size=512\" VITE_BUILD_MODE=fast EXCLUDE_AI_MODELS=true vite build",
    "build:ultra-light": "NODE_OPTIONS=\"--max-old-space-size=512\" VITE_BUILD_MODE=emergency EXCLUDE_AI_MODELS=true vite build --minify=false --sourcemap=false",
    "build:nano": "NODE_OPTIONS=\"--max-old-space-size=384\" VITE_BUILD_MODE=minimal EXCLUDE_AI_MODELS=true vite build --minify=false --sourcemap=false --target=es2020",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{json,js,jsx,ts,tsx,css,scss}\"",
    "generate": "dfx generate bonded-app-backend",
    "deploy": "npm run build && echo 'Deploy to Vercel/Netlify via their CLI or dashboard'",
    "deploy:laptop": "npm run build:laptop && echo 'Laptop-optimized build complete'",
    "deploy:minimal": "npm run build:minimal && echo 'Minimal deployment build ready'",
    "build:minimal": "NODE_OPTIONS=\"--max-old-space-size=512\" VITE_BUILD_MODE=minimal EXCLUDE_AI_MODELS=true vite build --target=es2020"
  },
  "dependencies": {
    "@dfinity/agent": "2.4.1",
    "@dfinity/auth-client": "2.4.1",
    "@dfinity/candid": "2.4.1",
    "@dfinity/identity": "2.4.1",
    "@dfinity/principal": "2.4.1",
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-backend-wasm": "^4.15.0",
    "@tensorflow/tfjs-backend-webgl": "^4.15.0",
    "@xenova/transformers": "^2.17.2",
    "buffer": "^6.0.3",
    "core-js": "^3.42.0",
    "crypto-browserify": "^3.12.1",
    "crypto-js": "^4.2.0",
    "idb": "^7.1.1",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "nsfwjs": "^4.2.1",
    "onnxruntime-web": "^1.16.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "react-select": "^5.10.1",
    "stream-browserify": "^3.0.0",
    "tesseract.js": "^6.0.1",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.1",
    "dotenv": "^16.3.1",
    "sass": "^1.63.6",
    "typescript": "^5.1.3",
    "vite": "^4.5.3",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-pwa": "^0.16.7",
    "workbox-cli": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "resolutions": {
    "@noble/curves": "1.4.0",
    "@dfinity/agent": "2.4.1",
    "@dfinity/auth-client": "2.4.1",
    "@dfinity/identity": "2.4.1"
  }
}
